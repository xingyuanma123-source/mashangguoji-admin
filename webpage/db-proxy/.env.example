# db-proxy —— 每个环境一份独立 .env（放在该环境的部署目录，绝不进 git）
#   prod   : SUPABASE_URL=prod 库、SUPABASE_SERVICE_KEY=prod service_role、PORT=3002
#   staging: SUPABASE_URL=staging 库、SUPABASE_SERVICE_KEY=staging service_role、PORT=4002
# service_role 是高权限密钥，从 Supabase Dashboard → Settings → API 取，仅填服务器 .env。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=43200
PORT=3002   # staging 改为 4002
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mashangguoji-admin.pages.dev,http://119.91.129.106
