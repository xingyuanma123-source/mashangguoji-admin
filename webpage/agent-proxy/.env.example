# agent-proxy —— 每个环境一份独立 .env（放在该环境的部署目录，绝不进 git）
#   prod   : SUPABASE_URL=prod 库、SUPABASE_SERVICE_KEY=prod service_role、PORT=3003
#   staging: SUPABASE_URL=staging 库、SUPABASE_SERVICE_KEY=staging service_role、PORT=4003
# service_role / LLM_API_KEY 等密钥仅填服务器 .env，绝不进 git。
# Supabase（与 db-proxy 相同）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
# 会话签名密钥：必须与 db-proxy 的 SESSION_SECRET 完全一致（共用登录 cookie）
SESSION_SECRET=
# LLM（agent 主循环，需使用 OpenAI 兼容接口并支持 function calling）
LLM_API_KEY=
# MiMo Token Plan 模型/端点
AGENT_MODEL=mimo-v2.5-pro
LLM_ENDPOINT=https://token-plan-sgp.xiaomimimo.com/v1/chat/completions
# 输出 token 上限；staging 快速模式默认 4096，按需调大
LLM_MAX_TOKENS=4096
# 模型请求超时，应小于 Nginx proxy_read_timeout（300s）
LLM_TIMEOUT_MS=120000
# 模型端点偶发 429/5xx 时的有限重试
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BASE_MS=500
# 服务
PORT=3003   # staging 改为 4003
HOST=127.0.0.1
ALLOWED_ORIGINS=https://your-domain.example
